digraph PRING_Schema_Simplified_Structured {
  graph [
    rankdir=LR,
    splines=polyline,
    overlap=false,
    fontname="Helvetica",
    fontsize=18,
    nodesep="0.35",
    ranksep="0.55",
    labelloc="t",
    label="PRING — simplified schema (structured)"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="white",
    fontname="Helvetica",
    fontsize=14
  ];

  edge [
    fontname="Helvetica",
    fontsize=12,
    color="gray35",
    penwidth=1.1
  ];

  subgraph cluster_core {
    label="Core entities";
    style="rounded,filled";
    color="aliceblue";

    Substance [label=< <B>Substance</B><BR/>SID (submitted record) >];
    Compound  [label=< <B>Compound</B><BR/>CID (normalized) >];
    Protein   [label=< <B>Protein target</B><BR/>(e.g., CYP450) >];
    Gene      [label=< <B>Gene</B><BR/>(optional in slide) >, fillcolor="white"];
  }

  subgraph cluster_evidence {
    label="Experimental evidence";
    style="rounded,filled";
    color="lavender";

    BioAssay    [label=< <B>BioAssay</B><BR/>AID >];
    AssayResult [label=< <B>Assay result</B><BR/>type + value + unit<BR/>+ outcome/quality >];
    Interaction [label=< <B>Interaction assertion</B><BR/>label + confidence<BR/>(ML target) >];
  }

  subgraph cluster_features {
    label="Chemical features (ML inputs)";
    style="rounded,filled";
    color="honeydew";

    Features [label=< <B>Features</B><BR/>structure + properties<BR/>+ synonyms/relations >];
  }

  subgraph cluster_prov {
    label="Provenance";
    style="rounded,filled";
    color="oldlace";

    Source    [label=< <B>Source</B> >];
    Reference [label=< <B>Reference</B><BR/>PMID/DOI/patent >];
  }

  subgraph cluster_optional {
    label="Optional context & enrichment";
    style="rounded,filled";
    color="gray95";

    Context [label=< <B>Context</B><BR/>pathway / cell line / disease >, fillcolor="mistyrose"];
    Plugins [label=< <B>Enrichment</B><BR/>UniProt/GO/ChEMBL/... >, fillcolor="lightyellow"];
  }

  // Main edges (kept minimal)
  Source   -> Substance [label="submits"];
  Substance-> Compound  [label="normalize"];
  BioAssay -> AssayResult [label="reports"];
  AssayResult -> Substance [label="tests"];
  AssayResult -> Protein   [label="measures on"];
  AssayResult -> Reference [label="supported by"];

  Gene -> Protein [label="encodes", style="dotted"];

  Compound -> Features [label="has"];
  Interaction -> Compound [label="chemical"];
  Interaction -> Protein  [label="target"];
  Interaction -> AssayResult [label="evidence"];

  Interaction -> Context [style="dotted", label="optional"];
  Compound -> Plugins [style="dashed", label="enrich"];
  Protein  -> Plugins [style="dashed", label="enrich"];

  // Prediction shortcut
  Compound -> Protein [style="dashed", penwidth=2, label=< <B>PREDICT</B> >, constraint=false];
}
