digraph PubChemRDF_PresentationReady_WithPlugins {
  graph [
    rankdir=LR,
    splines=ortho,
    overlap=false,
    fontname="Helvetica",
    fontsize=16,
    labelloc="t",
    label="PRING (PubChem RDF Interaction Network Graph) schema"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="white",
    fontname="Helvetica",
    fontsize=11
  ];

  edge [
    fontname="Helvetica",
    fontsize=10,
    color="gray35"
  ];

  // --------------------------------------------------------------------------
  // Module A — Core entities (what we connect)
  // --------------------------------------------------------------------------
  subgraph cluster_core {
    label="A) Core entities";
    style="rounded,filled";
    color="aliceblue";

    Compound  [label="Chemical (Compound)\nCID (standardized)"];
    Substance [label="Submitted chemical record (Substance)\nSID (from a data source)"];

    Protein   [label="Protein target\n(e.g., CYP450 enzyme)"];
    Gene      [label="Gene (encodes protein)"];
    Organism  [label="Organism / Taxonomy\n(human, mouse, …)"];
  }

  // --------------------------------------------------------------------------
  // Module B — Chemical features (inputs for ML)
  // --------------------------------------------------------------------------
  subgraph cluster_features {
    label="B) Chemical features (ML inputs)";
    style="rounded,filled";
    color="honeydew";

    Structure   [label="Structure\nSMILES / InChI / InChIKey"];
    Properties  [label="PhysChem properties\nMW, formula, logP, TPSA, …"];
    Synonyms    [label="Names / Synonyms"];
    Neighbors   [label="Related chemicals\nparents / components / similar"];
  }

  // --------------------------------------------------------------------------
  // Module C — Experimental evidence backbone (most important for interaction)
  // --------------------------------------------------------------------------
  subgraph cluster_evidence {
    label="C) Experimental evidence (interaction backbone)";
    style="rounded,filled";
    color="lavender";

    BioAssay    [label="BioAssay / Experiment\nAID"];
    MeasureGrp  [label="MeasureGroup\n(assay context / target panel row)"];
    Endpoint    [label="Endpoint (measurement)\nvalue + unit + type\n(IC50/Ki/Kd/…)\n+ outcome label"];
  }

  // --------------------------------------------------------------------------
  // Module D — Provenance & trust (where evidence comes from)
  // --------------------------------------------------------------------------
  subgraph cluster_prov {
    label="D) Provenance (trust)";
    style="rounded,filled";
    color="oldlace";

    Source   [label="Source / Depositor\n(dataset provider)"];
    Reference[label="Reference\n(paper / patent)"];
  }

  // --------------------------------------------------------------------------
  // Module E — Optional context (useful but not mandatory)
  // --------------------------------------------------------------------------
  subgraph cluster_context {
    label="E) Optional context";
    style="rounded,filled";
    color="mistyrose";

    Pathway  [label="Pathway / BioSystem\n(group of participants)"];
    CellLine [label="Cell line / cell type\n(optional)"];
    Anatomy  [label="Tissue / anatomy\n(optional)"];
    Disease  [label="Disease (optional)\n(mainly literature context)"];
  }

  // --------------------------------------------------------------------------
  // Module F — Text-mined associations (weak signal; keep separate)
  // --------------------------------------------------------------------------
  subgraph cluster_textmine {
    label="F) Text-mined links (weak signal)";
    style="rounded,filled";
    color="gray92";

    Cooc     [label="Co-occurrence association\n(mentioned together)\n+ score"];
    TextMine [label="Text mining method"];
  }

  // --------------------------------------------------------------------------
  // Module G — Enrichment plugins (optional external add-ons)
  // --------------------------------------------------------------------------
  subgraph cluster_plugins {
    label="G) Enrichment plugins (optional add-ons)";
    style="rounded,filled";
    color="lightyellow";

    UniProt   [label="UniProt plugin\n(canonical sequences,\nisoforms, function)"];
    GO        [label="GO plugin\n(term hierarchy,\nfunctions/locations)"];
    Reactome  [label="Reactome plugin\n(pathway network\ndetail)"];
    InterPro  [label="InterPro / CDD plugin\n(domains, families,\nactive sites)"];

    ChEMBL    [label="ChEMBL plugin\n(curated bioactivity,\nassay metadata)"];
    BindingDB [label="BindingDB plugin\n(curated binding\n(Kd/Ki/IC50))"];
    DrugBank  [label="DrugBank plugin\nmetabolism/enzymes\n(drug-centric)"];

    PDB       [label="PDB plugin\n(experimental 3D\nstructures)"];
    AlphaFold [label="AlphaFold plugin\n(predicted 3D\nstructures)"];

    // Optional: feature materialization nodes (for GCN input)
    ProtEmbed [label="Protein embedding\n(ESM/ProtBERT)"];
    MolGraph  [label="Molecular graph / fingerprint\n(RDKit, GNN-ready)"];
  }

  // =========================
  // Core normalization & source
  // =========================
  Substance -> Compound [label="standardized to\n(normalized)"];
  Substance -> Source   [label="submitted by"];

  // =========================
  // Chemical features
  // =========================
  Compound -> Structure  [label="has structure"];
  Compound -> Properties [label="has properties"];
  Compound -> Synonyms   [label="has names"];
  Compound -> Neighbors  [label="has neighbors / parents"];

  // =========================
  // Evidence backbone (key!)
  // =========================
  BioAssay   -> MeasureGrp [label="has measure group"];
  MeasureGrp -> Endpoint   [label="produces endpoint"];
  Endpoint   -> Substance  [label="is about tested record"];

  // Who/what is being tested
  MeasureGrp -> Protein    [label="tested on protein"];
  Protein    -> Gene       [label="encoded by"];
  MeasureGrp -> Organism   [label="in organism"];
  MeasureGrp -> CellLine   [label="in cell line (optional)"];

  // Evidence provenance
  BioAssay  -> Source     [label="has source"];
  Endpoint  -> Reference  [label="supported by"];
  BioAssay  -> Reference  [label="described by"];

  // Optional context connections
  Protein  -> Pathway [label="participates in (optional)"];
  Compound -> Pathway [label="participates in (optional)"];
  CellLine -> Anatomy [label="derived from (optional)"];

  // Text-mined module (keep separate from experimental evidence)
  Cooc -> Compound  [label="mentions chemical"];
  Cooc -> Protein   [label="mentions target\n(gene/protein name)"];
  Cooc -> Disease   [label="mentions disease (optional)"];
  Cooc -> Reference [label="found in"];
  Cooc -> TextMine  [label="extracted by"];

  // Prediction shortcut for slides
  Compound -> Protein [
    style="dashed",
    penwidth=2,
    label="PREDICT:\ninteraction likelihood\n(using evidence + features)"
  ];

  // =========================
  // Plugin connections (clean, optional, provenance-aware)
  // =========================

  // Protein-side enrichment
  Protein -> UniProt   [style="dashed", label="cross-reference / enrich"];
  UniProt -> ProtEmbed [style="dashed", label="compute embedding"];

  Protein -> InterPro  [style="dashed", label="domains / families"];
  Protein -> GO        [style="dashed", label="functional annotations"];
  Protein -> Reactome  [style="dashed", label="pathway details"];
  Reactome -> Pathway  [style="dashed", label="align pathways"];

  Protein -> PDB       [style="dashed", label="3D structure (if exists)"];
  Protein -> AlphaFold [style="dashed", label="predicted structure"];

  // Chemical-side enrichment
  Compound -> MolGraph [style="dashed", label="build molecular graph\nfrom SMILES"];
  Compound -> ChEMBL   [style="dashed", label="curated activities"];
  Compound -> BindingDB[style="dashed", label="curated binding"];
  Compound -> DrugBank [style="dashed", label="drug metabolism info"];

  // Evidence alignment / validation (optional)
  Endpoint -> ChEMBL    [style="dashed", label="harmonize assay/endpoints"];
  Endpoint -> BindingDB [style="dashed", label="validate Kd/Ki/IC50"];
  Protein  -> DrugBank  [style="dashed", label="enzyme/metabolism links"];
}
